<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI smoke: opens each window off-screen on a real view model, captures it, and runs the view-model scenarios.
       dotnet run (project tests/Stagewatch.UiSmoke) with arguments: outdir mode   (modes: main, main-ro, settings, screens,
       copilot, slides-agent, rundown-editor, vm, review). Exit code = failures. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StartupObject>UiSmoke.Program</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Timer.App\Timer.App.csproj" />
  </ItemGroup>
</Project>
