<Project Sdk="Microsoft.NET.Sdk">
  <!-- Page smoke: serves a realistic frame from the real web server and screenshots browser pages with headless Edge.
       dotnet run (project tests/Stagewatch.PageShot) with arguments: outdir [/page ...]. Exit code = pages that didn't render. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Timer.Remote\Timer.Remote.csproj" />
  </ItemGroup>
</Project>
