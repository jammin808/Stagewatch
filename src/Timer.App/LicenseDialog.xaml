<Window x:Class="Stagewatch.App.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License"
        Width="620" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="License" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="NoticeText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFFFC857" Visibility="Collapsed" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent">
            <TabItem Header="Plans">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="PlansText" TextWrapping="Wrap" LineHeight="20" />
                        <TextBlock Text="Your hardware ID (send it with your order):" Opacity="0.7" Margin="0,14,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HwidBox" IsReadOnly="True" Width="380" />
                            <Button Content="Copy" Width="70" Margin="8,0,0,0" Click="OnCopyHwid" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Enter master serial">
                <StackPanel Margin="10">
                    <TextBlock Text="Paste your master serial:" Opacity="0.7" />
                    <TextBox x:Name="SerialBox" Margin="0,6,0,12" />
                    <Button Content="Activate" Width="120" HorizontalAlignment="Left" Click="OnActivateSerial" />
                    <TextBlock Text="Master serials are issued by the owner via stagewatch-keygen master-serial." Opacity="0.5" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Install license file">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="License files are bound to this machine. Send your hardware ID (from Settings → About) to receive a .dat file." />
                    <Button Content="Choose .dat..." Margin="0,12,0,0" Width="160" HorizontalAlignment="Left" Click="OnInstallFile" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Sign out">
                <StackPanel Margin="10">
                    <TextBlock Text="Removes the saved license from this machine. Trial cannot be re-extended." Opacity="0.7" TextWrapping="Wrap" />
                    <Button Content="Sign out" Margin="0,12,0,0" Width="120" HorizontalAlignment="Left" Click="OnSignOut" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" Width="100" HorizontalAlignment="Right" Click="OnClose" />
    </Grid>
</Window>
