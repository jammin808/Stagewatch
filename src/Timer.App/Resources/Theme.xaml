<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Stagewatch.App">

    <app:ModeRadio x:Key="ModeRadio" />
    <app:SecondsToHms x:Key="SecondsToHms" />
    <app:OutputModeLabel x:Key="OutputModeLabel" />
    <app:HexToBrush x:Key="HexToBrush" />
    <app:InverseBoolToVis x:Key="InverseBoolToVis" />
    <app:NonEmptyToVis x:Key="NonEmptyToVis" />
    <app:NonEmptyToBool x:Key="NonEmptyToBool" />
    <app:TriggerSecretLabel x:Key="TriggerSecretLabel" />

    <!-- Palette: dark, calm, high-contrast for stage operators. -->
    <Color x:Key="BgDeep">#000000</Color>
    <Color x:Key="BgPanel">#080808</Color>
    <Color x:Key="BgRaised">#181818</Color>
    <Color x:Key="BgRaisedHover">#262626</Color>
    <Color x:Key="BorderSubtle">#2A2A2A</Color>
    <Color x:Key="BorderStrong">#3F3F3F</Color>
    <Color x:Key="TextPrimary">#F9FAFB</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>
    <Color x:Key="TextDim">#6B7280</Color>
    <Color x:Key="Accent">#22C55E</Color>
    <Color x:Key="AccentRed">#DC2626</Color>
    <Color x:Key="AccentAmber">#F59E0B</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
    <SolidColorBrush x:Key="BgRaisedBrush" Color="{StaticResource BgRaised}" />
    <SolidColorBrush x:Key="BgRaisedHoverBrush" Color="{StaticResource BgRaisedHover}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />

    <!-- Neon hints: used sparingly, to guide the eye (cyan = time input, violet = schedule, green = go). -->
    <Color x:Key="NeonCyan">#22D3EE</Color>
    <Color x:Key="NeonViolet">#A78BFA</Color>
    <Color x:Key="NeonGreen">#34D399</Color>
    <Color x:Key="NeonAmber">#FBBF24</Color>
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyan}" />
    <SolidColorBrush x:Key="NeonVioletBrush" Color="{StaticResource NeonViolet}" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreen}" />
    <SolidColorBrush x:Key="NeonAmberBrush" Color="{StaticResource NeonAmber}" />

    <!-- Window backdrop: near-black with a faint blue lift at the top. -->
    <RadialGradientBrush x:Key="AppBackdropBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Color="#0B1220" Offset="0" />
        <GradientStop Color="#000000" Offset="1" />
    </RadialGradientBrush>

    <!-- Panel fill and its hairline edge (cyan top-left fading to violet bottom-right). -->
    <LinearGradientBrush x:Key="PanelFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E1116" Offset="0" />
        <GradientStop Color="#08090C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5522D3EE" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.35" />
        <GradientStop Color="#18FFFFFF" Offset="0.7" />
        <GradientStop Color="#44A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3322D3EE" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.5" />
        <GradientStop Color="#2234D399" Offset="1" />
    </LinearGradientBrush>

    <!-- Button faces: a gentle top-lit gradient. -->
    <LinearGradientBrush x:Key="ButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#232831" Offset="0" />
        <GradientStop Color="#16191F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C333E" Offset="0" />
        <GradientStop Color="#1C2027" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFacePressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121418" Offset="0" />
        <GradientStop Color="#1A1D23" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A414D" Offset="0" />
        <GradientStop Color="#22262D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3EE08F" Offset="0" />
        <GradientStop Color="#16A34A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F04444" Offset="0" />
        <GradientStop Color="#B91C1C" Offset="1" />
    </LinearGradientBrush>

    <!-- A card: shadow on its own layer behind the panel, so changing content never re-renders an effect. -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="14" Background="#000000" Margin="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.75" Color="#000000" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The shadow behind a panel: a sibling placed first in the same cell. Its content never changes,
         so the effect is rendered once, not every time the timer ticks. -->
    <Style x:Key="ShadowPlate" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="#000000" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.8" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Dark tooltips: the implicit TextBlock style above makes their text light, which vanished on the default pale tooltip. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================== -->
    <!-- Buttons                                                         -->
    <!-- ============================================================== -->

    <!-- Big transport buttons -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonFaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="10" Background="{TemplateBinding Background}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.7"
                                                  Color="{Binding (app:Glow.Color), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- top highlight line -->
                                <Border Height="1" VerticalAlignment="Top" Margin="8,0" Background="#26FFFFFF" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7722D3EE" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonFacePressedBrush}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportButtonAccent" TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="Background" Value="{StaticResource AccentFaceBrush}" />
        <Setter Property="Foreground" Value="#052012" />
        <Setter Property="BorderBrush" Value="#5534D399" />
        <Setter Property="app:Glow.Color" Value="{StaticResource NeonGreen}" />
    </Style>

    <Style x:Key="TransportButtonRed" TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="Background" Value="{StaticResource RedFaceBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#55F87171" />
        <Setter Property="app:Glow.Color" Value="{StaticResource AccentRed}" />
    </Style>

    <!-- Default Button — dialogs, Settings, the side panel. Same face, smaller. -->
    <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Preset tile -->
    <Style x:Key="PresetTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Nudges: big, spaced, and tinted — amber takes time away, green gives it. -->
    <Style x:Key="NudgeButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="2,8" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="NudgeMinus" TargetType="Button" BasedOn="{StaticResource NudgeButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonAmberBrush}" />
        <Setter Property="BorderBrush" Value="#55FBBF24" />
        <Setter Property="app:Glow.Color" Value="{StaticResource NeonAmber}" />
    </Style>
    <Style x:Key="NudgePlus" TargetType="Button" BasedOn="{StaticResource NudgeButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="BorderBrush" Value="#5534D399" />
        <Setter Property="app:Glow.Color" Value="{StaticResource NeonGreen}" />
    </Style>

    <!-- Large inputs on the main window (duration, end at, message). -->
    <Style x:Key="BigInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonFaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- CheckBox — dark glyph                                           -->
    <!-- ============================================================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 4 9 L 8 13 L 14 5"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Stroke" Value="#062812" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- ComboBox — fully templated for dark theme                       -->
    <!-- ============================================================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgRaisedHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgRaisedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd"
                CornerRadius="6"
                Background="{StaticResource BgRaisedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <Grid>
                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Fill="{StaticResource TextMutedBrush}"
                      Data="M 0 0 L 8 0 L 4 6 Z" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgRaisedHoverBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleTemplate}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border CornerRadius="6"
                                    Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- TabControl + TabItem                                            -->
    <!-- ============================================================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0,0,0,-1" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,6,6">
                            <ContentPresenter ContentSource="SelectedContent"
                                              Margin="4" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Right-click menus (dark; the implicit TextBlock style would make  -->
    <!-- text invisible on the default pale menu)                         -->
    <!-- ============================================================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200" Margin="0,0,6,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Opacity="0.5" FontSize="12"
                                       Margin="24,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgRaisedHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- The explanation at the top of a help menu: text, not a command. -->
                        <Trigger Property="Tag" Value="explanation">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" SnapsToDevicePixels="True" Background="{StaticResource BorderStrongBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Data grids (Settings → Triggers, running order, presets)        -->
    <!-- ============================================================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#14321F" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cell editors: the grid columns set these explicitly (implicit styles don't reach them). -->
    <Style x:Key="GridEditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource BgRaisedHoverBrush}" />
    </Style>
    <Style x:Key="GridCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style x:Key="GridCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================== -->
    <!-- GroupBox                                                        -->
    <!-- ============================================================== -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>

</ResourceDictionary>
