<Window x:Class="Stagewatch.App.SendLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:Stagewatch.App.Help"
        Title="Send a line"
        Width="660" Height="600" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <!-- One line for another show app, in that app's own words. Everything here is the desk service's answer for the line as it stands
         (DeskService.Preview), read again as it is typed and once a second: the form that takes it, that form's risk as a word on a
         chip, whether the app is asking this desk for its lines, and why Send is grey. The press sends the same string. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Opacity="0.65" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="One line, in that app's own words. It goes as typed, approved by you; the app collects it, runs it itself and reports back here. Only a line its verbs list is sent, and no deck's recorder takes it." />
        </StackPanel>

        <!-- Whether the app is asking this desk for its approved lines now: a shape and the words, never colour alone. -->
        <TextBlock Grid.Row="1" x:Name="CollectText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" help:ContextHelp.Tip="send-line" Background="Transparent" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LineBox" FontFamily="Consolas" FontSize="15" Padding="8,6" help:ContextHelp.Tip="send-line"
                     ToolTip="The line, as the app reads it — pick one of its verbs below to start it" />
            <!-- The risk of the form that takes the line, as the app lists it: the word is the cue, the tint follows it. -->
            <Border Grid.Column="1" x:Name="RiskChip" Padding="8,2" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" help:ContextHelp.Tip="send-line">
                <TextBlock x:Name="RiskText" FontSize="11" FontWeight="Bold" />
            </Border>
        </Grid>

        <!-- The form that takes the line, and that row's own words. -->
        <StackPanel Grid.Row="3" Margin="0,6,0,8">
            <TextBlock x:Name="FormText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock x:Name="FormWords" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- The app's verified verbs the typed words could still become, in its own order: a press starts the line with that form's opening words. -->
        <Border Grid.Row="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgPanelBrush}" help:ContextHelp.Tip="send-line-forms">
            <Grid>
                <TextBlock x:Name="FormsEmpty" Margin="12,10" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed" />
                <ItemsControl x:Name="FormsList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Focusable="False">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnPickForm" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="10,5" MinHeight="0" MinWidth="0"
                                    ToolTip="Start the line with this form's opening words">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Form}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Words}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                                   Visibility="{Binding Words, Converter={StaticResource NonEmptyToVis}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="4" Margin="8,1,0,0" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334ADE80" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Risk}" Value="review"><Setter Property="Background" Value="#33F59E0B" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Risk}" Value="high"><Setter Property="Background" Value="#55DC2626" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- What the last press came to: sent, then what the app did with it — its own words. -->
        <TextBlock Grid.Row="5" x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,6" Click="OnClose" IsCancel="True" />
            <Button DockPanel.Dock="Right" x:Name="SendButton" Content="Send" Padding="16,6" Margin="0,0,8,0" Click="OnSend" IsDefault="True" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True" help:ContextHelp.Tip="send-line" />
            <!-- Why Send is grey, in the words the send itself would refuse the line in. -->
            <TextBlock x:Name="WhyText" FontSize="12" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
