<Window x:Class="Stagewatch.App.CopilotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot"
        Width="760" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="&#x2728; Copilot" FontSize="20" FontWeight="Bold" />
            <TextBlock Opacity="0.65" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="Ask in plain English. The copilot answers, or proposes a plan in Stagewatch's own commands — nothing runs until you tick it and press Run. AI agents connected over MCP propose here too." />
        </StackPanel>

        <Border Grid.Row="1" x:Name="Unavailable" Padding="10,8" CornerRadius="6" Margin="0,0,0,10" Background="#33F59E0B" BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1">
            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Text="{Binding CopilotInput, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="8,6"
                     KeyDown="OnInputKey" TextWrapping="Wrap" MaxLength="1000"
                     ToolTip="e.g. &quot;We're 6 minutes late — get us back on time without touching the keynote&quot;" />
            <Button x:Name="AskButton" Grid.Column="1" Content="Propose" Margin="8,0,0,0" Padding="16,6" Click="OnAsk" IsDefault="False" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Padding="16,6" Command="{Binding CancelCopilotCommand}" Visibility="Collapsed" />
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Style="{StaticResource Chip}" Content="Get us back on time" Click="OnChip" Tag="We're running late. Propose the smallest set of trims or delays that gets us back on schedule before the next curfew, without rushing the live speaker." />
            <Button Style="{StaticResource Chip}" Content="Will we make the curfew?" Click="OnChip" Tag="Are we going to finish before the curfew? What's the main risk, and what would you do now?" />
            <Button Style="{StaticResource Chip}" Content="Triage the questions" Click="OnChip" Tag="Look at the new audience questions. Propose approving the best ones (merge duplicates in your reasons) and leave anything inappropriate unapproved." />
            <Button Style="{StaticResource Chip}" Content="Kind wrap-up for the speaker" Click="OnChip" Tag="Draft a short, kind message asking the live speaker to start wrapping up, with the time left, and propose sending it with an acknowledgement." />
            <Button Style="{StaticResource Chip}" Content="Set up the break" Click="OnChip" Tag="The next item is a break. Propose what to put on the screens and timers for it." />
            <Button Style="{StaticResource Chip}" Content="Find all screens" Click="OnChip" Tag="Identify every screen." />
            <Button Style="{StaticResource Chip}" Content="&#x2728; Review the plan" Command="{Binding ReviewPlanCommand}"
                    ToolTip="Findings for the whole running order, using your own overrun history, with fixes to approve" />
            <Button Style="{StaticResource Chip}" Content="&#x2728; Explain a problem" Command="{Binding ExplainProblemsCommand}"
                    ToolTip="What's wrong with the setup (links, refused commands, screens) and how to fix it" />
            <Button x:Name="TalkButton" Style="{StaticResource Chip}" Content="&#x1F399; Hold to talk (F9)"
                    PreviewMouseLeftButtonDown="OnTalkDown" PreviewMouseLeftButtonUp="OnTalkUp" MouseLeave="OnTalkUp"
                    ToolTip="Hold, say what you need (&quot;we're five minutes late, protect the keynote&quot;), let go. It becomes a plan you approve. Windows speech, offline." />
        </WrapPanel>

        <StackPanel Grid.Row="4" Margin="0,4,0,8">
            <TextBlock Text="{Binding TalkCaption}" FontSize="16" FontStyle="Italic" Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"
                       Visibility="{Binding TalkCaption, Converter={StaticResource NonEmptyToVis}}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CopilotStatus}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Proposals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="8" Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12" Opacity="0.7" />
                                    <TextBlock FontSize="12" Opacity="0.7">
                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CreatedText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Request}" FontStyle="Italic" Opacity="0.85" Margin="0,4,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="&#x2026; thinking" Foreground="{StaticResource NeonGreenBrush}"
                                           Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="{Binding Reply, Converter={StaticResource NonEmptyToVis}}" />
                                <Border Visibility="{Binding Consequence, Converter={StaticResource NonEmptyToVis}}" Padding="8,4" CornerRadius="6" Margin="0,0,0,6"
                                        Background="#1A22D3EE" BorderBrush="#5522D3EE" BorderThickness="1">
                                    <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" FontSize="13" />
                                </Border>
                                <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource AccentAmberBrush}"
                                           Visibility="{Binding Question, Converter={StaticResource NonEmptyToVis}}" />
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                          IsEnabled="{Binding DataContext.IsPending, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Why}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Result}" FontSize="12" Foreground="{StaticResource NeonGreenBrush}"
                                                               Visibility="{Binding Result, Converter={StaticResource NonEmptyToVis}}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="6,1" CornerRadius="4" Margin="8,2,0,0" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#334ADE80" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Review"><Setter Property="Background" Value="#33F59E0B" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Risk}" Value="High"><Setter Property="Background" Value="#55DC2626" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RiskLabel}" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Dropped}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Dropped, Converter={StaticResource NonEmptyToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Run ticked steps" Padding="12,5" Margin="0,0,8,0"
                                            Command="{Binding DataContext.ApproveProposalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Content="Discard" Padding="12,5"
                                            Command="{Binding DataContext.DiscardProposalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,6" Click="OnClose" IsCancel="True" />
            <Button DockPanel.Dock="Left" Content="Clear finished" Padding="12,6" Command="{Binding ClearProposalsCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="Red = changes what the room sees: never ticked for you. Every request and approval goes in the show report." Opacity="0.5"
                       FontSize="12" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
