<Window x:Class="Stagewatch.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:Stagewatch.App.Help"
        Title="Settings"
        Width="900" Height="760" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- OUTPUT -->
            <TabItem Header="Output" help:ContextHelp.Topic="outputs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Target monitor" Opacity="0.7" />
                        <ComboBox x:Name="MonitorCombo" Margin="0,4,0,14" />

                        <TextBlock Text="Default chroma key color" Opacity="0.7" />
                        <ComboBox x:Name="KeyColorCombo" Margin="0,4,0,14">
                            <ComboBoxItem Content="Blue" />
                            <ComboBoxItem Content="Green" />
                            <ComboBoxItem Content="Magenta" />
                            <ComboBoxItem Content="Black" />
                        </ComboBox>

                        <TextBlock Text="Elements shown on output" Opacity="0.7" Margin="0,0,0,4" />
                        <CheckBox x:Name="ShowTimer" Content="Timer" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowMessage" Content="Message" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowEndTimeOutput" Content="End time" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowTod" Content="Time of day" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowPreset" Content="Title (preset / running-order item)" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowProgress" Content="Progress bar" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowNextUp" Content="Next item (running order)" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowSchedule" Content="Ahead / behind schedule (running order)" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowCueLabel" Content="Cue label (“5 MIN”, “WRAP UP”) — a cue that doesn't rely on colour" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowFinishBy" Content="“FINISH BY 10:49” (instead of the end time)" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowSlides" Content="Slide n / N and next slide title (PowerPoint)" Margin="0,4,0,4" />
                        <CheckBox x:Name="ShowPlayout" Content="Video (VT) countdown from vMix" Margin="0,4,0,14" />

                        <TextBlock Text="Display style · Pro" FontWeight="SemiBold" />
                        <CheckBox x:Name="HoloOn" Margin="0,6,0,4" help:ContextHelp.Tip="holo-setting"
                                  Content="3D display on the output window and browser screens" />
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,4">
                            <RadioButton x:Name="SceneHolo" GroupName="Scene3D" Content="Hologram — text floating above a projector" Margin="0,0,18,0" />
                            <RadioButton x:Name="SceneEgg" GroupName="Scene3D" Content="Egg timer — a 3D hourglass" />
                        </StackPanel>
                        <CheckBox x:Name="HoloFloorOn" Margin="24,2,0,4" Content="Hologram: projector base, light beam and floor reflection" />
                        <CheckBox x:Name="Anim3DOn" Margin="24,2,0,4"
                                  Content="Animated transitions — messages build in, warnings breathe, critical messages and overtime grab attention" />
                        <CheckBox x:Name="Particles3DOn" Margin="24,2,0,4" Content="Particles — dust in the beam, motes around the egg timer" />
                        <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,14"
                                   Text="Uses the graphics card (three.js / WebGL). If it can't run or stops responding, Stagewatch switches back to the standard display by itself. NDI keeps sending the standard look." />

                        <TextBlock Text="NDI source name" Opacity="0.7" />
                        <TextBox x:Name="NdiName" Margin="0,4,0,14" />
                        <TextBlock Text="NDI frame rate" Opacity="0.7" />
                        <ComboBox x:Name="NdiFps" Margin="0,4,0,14">
                            <ComboBoxItem Content="25" />
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="50" />
                            <ComboBoxItem Content="60" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TIMER BEHAVIOR -->
            <TabItem Header="Timer" help:ContextHelp.Topic="timer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="AllowOvertime" Content="Continue counting negative after zero" Margin="0,4,0,4" />
                        <CheckBox x:Name="HideAtZero" Content="Hide the time on speaker screens at zero (the operator still sees overtime)" Margin="0,4,0,8" />
                        <CheckBox x:Name="OperatorShortcuts" Content="Enable operator keyboard shortcuts" Margin="0,4,0,8" />
                        <CheckBox x:Name="ShowEndTimeUi" Content="Show ‘ends HH:MM:SS’ under the timer" Margin="0,4,0,8" />
                        <CheckBox x:Name="Use12Hour" Content="12-hour clock (2:30:15 PM instead of 14:30:15)" Margin="0,4,0,14" />

                        <TextBlock Text="Timer face colors" FontWeight="SemiBold" Margin="0,4,0,6" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Normal color" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="NormalColorCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="#FFFFFF" Content="White" />
                                <ComboBoxItem Tag="#E2E8F0" Content="Light gray" />
                                <ComboBoxItem Tag="#FAF5DC" Content="Pale yellow" />
                                <ComboBoxItem Tag="#86EFAC" Content="Pale green" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Warning color" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="WarningColorCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="#F59E0B" Content="Amber" />
                                <ComboBoxItem Tag="#F97316" Content="Orange" />
                                <ComboBoxItem Tag="#FACC15" Content="Yellow" />
                                <ComboBoxItem Tag="#EC4899" Content="Pink" />
                                <ComboBoxItem Tag="#22D3EE" Content="Cyan" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Warning threshold (seconds)" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="WarningSeconds" Grid.Column="1" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Wrap-up color" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="WrapUpColorCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="#F97316" Content="Orange" />
                                <ComboBoxItem Tag="#EF4444" Content="Red" />
                                <ComboBoxItem Tag="#EC4899" Content="Pink" />
                                <ComboBoxItem Tag="#FACC15" Content="Yellow" />
                                <ComboBoxItem Tag="#A855F7" Content="Purple" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Wrap-up threshold (seconds)" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="WrapUpSeconds" Grid.Column="1" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Overtime color" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="OvertimeColorCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="#DC2626" Content="Red" />
                                <ComboBoxItem Tag="#B91C1C" Content="Dark red" />
                                <ComboBoxItem Tag="#A855F7" Content="Purple" />
                                <ComboBoxItem Tag="#F97316" Content="Orange" />
                                <ComboBoxItem Tag="#EC4899" Content="Pink" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Flash on time-up" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExpiredFlashCombo" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Off"  Content="No flash" />
                                <ComboBoxItem Tag="Slow" Content="Slow flash" />
                                <ComboBoxItem Tag="Fast" Content="Fast flash" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Auto-flash thresholds (separate from color)" FontWeight="SemiBold" Margin="0,4,0,6" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slow flash from (seconds)" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="WarnFlashSeconds" Grid.Column="1" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fast flash from (seconds)" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="CritFlashSeconds" Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="Sound alerts (this PC's speakers)" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <CheckBox x:Name="AlertWarning" Content="Two beeps at the warning threshold" Margin="0,4,0,4" />
                        <CheckBox x:Name="AlertWrapUp" Content="Three beeps at the wrap-up threshold" Margin="0,4,0,4" />
                        <CheckBox x:Name="AlertZero" Content="Chime when time is up" Margin="0,4,0,4" />
                        <CheckBox x:Name="AlertStart" Content="Short chime when a running-order item starts" Margin="0,4,0,4" />
                        <TextBlock Text="Chime library (WAV) — give items their own chimes in Running order → Edit → Chimes" Opacity="0.7" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ListBox x:Name="SoundList" Height="90" DisplayMemberPath="Label" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="Add WAV…" Click="OnAddSound" Margin="0,0,0,4" />
                                <Button Content="Play" Click="OnPlaySound" Margin="0,0,0,4" />
                                <Button Content="Remove" Click="OnRemoveSound" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Play alerts on" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="AlertDevice" Grid.Column="1" />
                            <Button Grid.Column="2" Content="Test" Click="OnTestAlert" Margin="8,0,0,0" MinWidth="70" />
                        </Grid>
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="At events the Windows default device is often the sound desk — pick the laptop speaker or headphones so cues don't go out to the room. If the chosen device is unplugged, alerts are skipped (never sent to the default)." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- COMPANION -->
            <TabItem Header="Companion" help:ContextHelp.Topic="companion">
                <StackPanel Margin="14">
                    <TextBlock Text="BitFocus Companion TCP server" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="CompanionEnabled" Content="Enabled" Margin="0,4,0,8" />
                    <TextBlock Text="Port" Opacity="0.7" />
                    <TextBox x:Name="CompanionPort" Margin="0,4,0,8" />
                    <CheckBox x:Name="CompanionAllInterfaces" Content="Bind on all interfaces (LAN access)" Margin="0,4,0,14" />
                    <TextBlock Text="See docs/COMPANION.md for the protocol and starter Companion module." Opacity="0.5" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <!-- REMOTE -->
            <TabItem Header="Remote" help:ContextHelp.Topic="remote">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Browser viewer &amp; remote control" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Any phone, tablet or laptop on the same network can open the timer in a browser — as a confidence monitor, or as a remote control (PIN protected)." />
                        <CheckBox x:Name="WebEnabled" Content="Enabled" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="WebPort" Grid.Column="1" Width="100" HorizontalAlignment="Left" />
                        </Grid>
                        <CheckBox x:Name="WebBindAll" Content="Allow other devices on the network (off = this PC only)" Margin="0,4,0,8" />
                        <CheckBox x:Name="WebHttps" Content="Encrypted connections (HTTPS) too — same port, plain HTTP keeps working" Margin="0,0,0,4"
                                  ToolTip="Stagewatch's own certificate (made once for this PC). Screens that trust it get https:// and wss://." />
                        <CheckBox x:Name="WebRequireHttps" Content="Require HTTPS from other devices (plain HTTP is sent to https://)" Margin="24,0,0,4"
                                  ToolTip="Screens must trust the certificate first: open /tls on each device. This PC can always use plain HTTP." />
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                            <TextBlock x:Name="CertFingerprint" FontFamily="Consolas" FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                            <Button Content="Certificate page" Click="OnCertificatePage" Margin="8,0,0,0" Padding="10,2" MinHeight="0" FontSize="12"
                                    ToolTip="Open /tls: the fingerprint and how to trust it on Windows, macOS, iPhone/iPad and Android" />
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Remote control PIN" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="RemotePin" Grid.Column="1" Width="100" FontFamily="Consolas" />
                            <Button Grid.Column="2" Content="New PIN" Click="OnNewPin" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Leave the PIN blank to allow control without one (not recommended on shared networks). Viewing never needs a PIN; reports and the operator's view do." />
                        <CheckBox x:Name="CrewKeysOn" Margin="0,0,0,4"
                                  Content="Crew pages confirm cues only when opened from their crew link (recommended)" />
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,12">
                            <Button Content="New crew links" Click="OnNewCrewKeys" Padding="10,4" MinHeight="0" FontSize="12" />
                            <TextBlock x:Name="CrewKeysNote" Opacity="0.55" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="460"
                                       Text="Revokes every crew link. Hand out the new ones from the Showcaller page (Crew links) or the list below." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Viewing code for screens (optional)" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ViewCode" Width="120" MaxLength="20"
                                     ToolTip="On a public or shared network: every browser screen must enter this code once (crew links and the PIN pass). Empty = open." />
                        </StackPanel>
                        <TextBlock Text="API keys — for scripts, dashboards and AI agents, so you needn't share the PIN" Opacity="0.7" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ListBox x:Name="ApiKeyList" Height="84" DisplayMemberPath="Label" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="New key…" Click="OnNewApiKey" Margin="0,0,0,4" />
                                <Button Content="Revoke" Click="OnRevokeApiKey" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Send a key as  Authorization: Bearer swk_…  (or ?pin=swk_…). Read keys see the operator's state, reports and screens; control keys also run /api commands; MCP keys also reach /mcp. 600 requests a minute each — replies carry X-RateLimit-Remaining. Revoking works at once." />
                        <TextBlock Text="Custom CSS for browser screens" Opacity="0.7" Margin="0,0,0,4" />
                        <TextBox x:Name="CustomCss" AcceptsReturn="True" AcceptsTab="True" Height="110" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                 ToolTip="e.g.  .sw-page-viewer #timer { font-family: 'Bebas Neue'; }   — each page's html has class sw-page-viewer, sw-page-audience, sw-page-clock…" />
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"
                                   Text="Applies to every browser screen within a second (not the output window or NDI). Target one page with .sw-page-viewer, .sw-page-audience, .sw-page-clock, .sw-page-timeline …" />
                        <TextBlock Text="Open on another device" Opacity="0.7" Margin="0,0,0,4" />
                        <ItemsControl x:Name="RemoteUrls" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Copy" Click="OnCopyUrl" Tag="{Binding}" Padding="10,2" MinHeight="0" Margin="6,0,0,0" />
                                        <Button Grid.Column="2" Content="Open" Click="OnOpenUrl" Tag="{Binding}" Padding="10,2" MinHeight="0" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="OSC (QLab, vMix, lighting desks)" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Receives /stagewatch/start, /stagewatch/next, /stagewatch/nudge 60 … over UDP. OSC has no PIN — only enable it on a trusted show network." />
                        <CheckBox x:Name="OscEnabled" Content="Enabled" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Listen port (UDP)" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="OscPort" Grid.Column="1" Width="100" HorizontalAlignment="Left" />
                        </Grid>
                        <CheckBox x:Name="OscBindAll" Content="Allow other devices on the network" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Send feedback to" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox x:Name="OscFeedbackHost" Grid.Column="1" ToolTip="IP or host name. Blank = no feedback." />
                            <TextBox x:Name="OscFeedbackPort" Grid.Column="2" Width="80" Margin="8,0,0,0" ToolTip="UDP port" />
                        </Grid>
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                                   Text="Full command list: docs/REMOTE.md, or /api/help in a browser." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CUES -->
            <TabItem Header="Cues" help:ContextHelp.Topic="cues">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Default cue ladder" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="The graduated signals the speaker sees. Items in the running order can pick their own. Standard follows the thresholds on the Timer tab." />
                        <ComboBox x:Name="LadderCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,14" />

                        <TextBlock Text="Speaker clock" FontWeight="SemiBold" />
                        <ComboBox x:Name="SpeakerFormatCombo" Margin="0,6,0,4">
                            <ComboBoxItem Content="Standard (MM:SS)" Tag="Standard" />
                            <ComboBoxItem Content="Calm — “12 MIN” until the last minute" Tag="Calm" />
                            <ComboBoxItem Content="Progress bar and cue only — no numbers" Tag="ProgressOnly" />
                        </ComboBox>
                        <CheckBox x:Name="HonestClock" Margin="0,8,0,4"
                                  Content="Never show the speaker a stretched clock (elastic end-at shows them the real time left)" />
                        <CheckBox x:Name="StableLayoutBox" Content="Stable layout: reserve space for messages so the timer never jumps" Margin="0,4,0,4" />
                        <CheckBox x:Name="ColourBlindBox" Content="Colour-blind-safe colours (blue / yellow / vermillion)" Margin="0,4,0,14" />

                        <TextBlock Text="Acknowledgements · Production" FontWeight="SemiBold" />
                        <CheckBox x:Name="AckDefault" Content="Messages ask the speaker to acknowledge by default" Margin="0,6,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <TextBlock Text="Escalate an unanswered cue after" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBox x:Name="EscalateSeconds" Width="60" Margin="8,0" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.8" />
                        </StackPanel>

                        <TextBlock Text="Departments (standby / GO) · Production" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.55" FontSize="12" Text="Comma separated. Each gets its own page: /dept?name=Lighting" Margin="0,2,0,6" />
                        <TextBox x:Name="DepartmentsBox" Margin="0,0,0,14" />

                        <TextBlock Text="Cue sound devices" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Send each cue to a different output — e.g. wrap-up to the talent's in-ear feed, never the PA. Blank = the alert device on the Timer tab." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Warning" VerticalAlignment="Center" Opacity="0.8" />
                            <ComboBox x:Name="WarnDevice" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Wrap-up" VerticalAlignment="Center" Opacity="0.8" />
                            <ComboBox x:Name="WrapDevice" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Time's up" VerticalAlignment="Center" Opacity="0.8" />
                            <ComboBox x:Name="ZeroDevice" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="Spoken cues to" VerticalAlignment="Center" Opacity="0.8" />
                            <ComboBox x:Name="TalentDevice" Grid.Row="3" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="4" Text="Voice" VerticalAlignment="Center" Opacity="0.8" />
                            <ComboBox x:Name="VoiceCombo" Grid.Row="4" Grid.Column="1" Margin="0,2" />
                        </Grid>
                        <Button Content="Test spoken cue" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnTestVoice" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- INTEGRATIONS -->
            <TabItem Header="Integrations" help:ContextHelp.Topic="integrations">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Status" FontWeight="SemiBold" />
                        <ItemsControl x:Name="IntegrationList" Margin="0,6,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Room name (multi-room dashboard) · Production" FontWeight="SemiBold" />
                        <TextBox x:Name="RoomName" Margin="0,4,0,4" />
                        <CheckBox x:Name="RoomsEnabled" Content="Share this room with other Stagewatch PCs on the network (UDP 9927) — see /rooms" Margin="0,4,0,14" />

                        <TextBlock Text="Presentation" FontWeight="SemiBold" />
                        <CheckBox x:Name="PowerPointOn" Content="Read the running PowerPoint slideshow (slide n/N, next title, rehearsal timings) — no add-in needed" Margin="0,6,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Follow slides from" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SlidesSource" Width="380"
                                      ToolTip="Presenter PCs run Stagewatch Slides (in the Stagewatch folder) and send their slideshow here" />
                        </StackPanel>
                        <TextBlock Text="Script for speech tracking (.txt) · Production — blank = the PowerPoint speaker notes" Opacity="0.7" Margin="0,8,0,2" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ScriptPath" />
                            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseScript" />
                        </Grid>
                        <TextBlock Text="Speech language" Opacity="0.7" Margin="0,8,0,2" />
                        <ComboBox x:Name="SpeechCulture" Margin="0,0,0,14" />

                        <TextBlock Text="Video playout · Production" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <CheckBox x:Name="VmixOn" Content="vMix VT countdown from" VerticalAlignment="Center" />
                            <TextBox x:Name="VmixHost" Width="150" Margin="8,0,4,0" />
                            <TextBlock Text=":" VerticalAlignment="Center" />
                            <TextBox x:Name="VmixPort" Width="70" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="PatternsOn" Content="Patterns video from" VerticalAlignment="Center"
                                      ToolTip="The clip on air in Patterns drives the VT countdown, and Last 10 s jumps it to its end (Patterns' wire, TCP 9697)" />
                            <ComboBox x:Name="PatternsHost" Width="150" Margin="8,0,4,0" IsEditable="True" />
                            <TextBlock Text=":" VerticalAlignment="Center" />
                            <TextBox x:Name="PatternsPort" Width="70" Margin="4,0,0,0" />
                            <Button Content="Find" Click="OnFindPatterns" Margin="8,0,0,0" Padding="10,2" MinHeight="0"
                                    ToolTip="Listen for Patterns machines on this network for 3 seconds (their beacon, UDP 9700)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                            <TextBlock Text="Pairing token" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <PasswordBox x:Name="PatternsToken" Width="180" ToolTip="Patterns → Remote → TRUST. Leave empty if the desk asks for none." />
                        </StackPanel>
                        <CheckBox x:Name="PatternsNextOnEnd" Content="When the clip ends on a video item, go to the next item" Margin="24,2,0,4"
                                  ToolTip="The live item must be a Video item (or labelled VT). The clip ending is also a trigger (Triggers → Clip ends)." />
                        <TextBlock x:Name="PatternsNote" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,14"
                                   Text="With vMix and Patterns both on, the VT countdown follows whichever is playing (Patterns if both)." />

                        <TextBlock Text="Cue lights · Production" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="A lectern or stage-edge light that follows the cue ladder: dark while normal, then the cue colours, flashing at time. Fixture: RGB (3 ch), RGBW (4), Dimmer+RGB (4) or Dimmer (1)." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="ArtNetOn" Content="Art-Net to" VerticalAlignment="Center" />
                            <TextBox x:Name="ArtNetHost" Width="150" Margin="8,0,14,0" ToolTip="255.255.255.255 = broadcast, or the node's IP" />
                            <CheckBox x:Name="SacnOn" Content="sACN (multicast)" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Universe" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBox x:Name="DmxUniverse" Width="60" Margin="6,0,14,0" />
                            <TextBlock Text="Address" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBox x:Name="DmxAddress" Width="60" Margin="6,0,14,0" />
                            <ComboBox x:Name="DmxModeCombo" Width="140" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <CheckBox x:Name="HueOn" Content="Philips Hue bridge" VerticalAlignment="Center" />
                            <TextBox x:Name="HueBridge" Width="120" Margin="8,0,4,0" ToolTip="Bridge IP address" />
                            <TextBox x:Name="HueUser" Width="140" Margin="4,0,4,0" ToolTip="Bridge username (press the link button, then create one with the Hue API)" />
                            <TextBox x:Name="HueLights" Width="90" Margin="4,0,0,0" ToolTip="Light ids, comma separated" />
                        </StackPanel>

                        <TextBlock Text="Time · Production" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <CheckBox x:Name="NtpOn" Content="Check this PC's clock against" VerticalAlignment="Center" />
                            <TextBox x:Name="NtpServer" Width="180" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="LtcOn" Content="LTC timecode out on" VerticalAlignment="Center" />
                            <ComboBox x:Name="LtcDevice" Width="200" Margin="8,0,6,0" />
                            <ComboBox x:Name="LtcFps" Width="70" Margin="0,0,6,0">
                                <ComboBoxItem Content="24" /><ComboBoxItem Content="25" /><ComboBoxItem Content="30" />
                            </ComboBox>
                            <ComboBox x:Name="LtcSource" Width="150">
                                <ComboBoxItem Content="Time of day" Tag="tod" />
                                <ComboBoxItem Content="Countdown" Tag="countdown" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="LtcInOn" Content="LTC timecode in from" VerticalAlignment="Center"
                                      ToolTip="Read SMPTE LTC (24/25/30 fps, auto-detected) from an audio input, e.g. a video playback or lighting desk's timecode feed" />
                            <ComboBox x:Name="LtcInDevice" Width="200" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,2,0,14">
                            <CheckBox x:Name="LtcChaseOn" Content="Timer follows it, counting down to" VerticalAlignment="Center"
                                      ToolTip="Start the timer when timecode rolls and pause it when it stops. With an end timecode, the remaining time is kept equal to end − timecode." />
                            <TextBox x:Name="LtcEnd" Width="110" Margin="8,0,6,0" ToolTip="Optional end timecode HH:MM:SS:FF (e.g. the last frame of the video). Leave empty to just start/pause." />
                            <TextBlock Text="(optional, HH:MM:SS:FF)" Opacity="0.55" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Producer assistant · Production" FontWeight="SemiBold" />
                        <CheckBox x:Name="AssistantOn" Content="Suggest trims, cues and fixes (rule-based, runs on this PC)" Margin="0,6,0,4" />
                        <CheckBox x:Name="AgentApprovalOn" Margin="0,4,0,4" Content="AI agents (MCP) must be approved in Copilot before anything runs (recommended)" />
                        <CheckBox x:Name="AssistantCloudOn" Margin="0,4,0,4"
                                  Content="Also ask Claude (sends the running order and timings to Anthropic) — needs an API key" />
                        <PasswordBox x:Name="AssistantKey" Margin="0,4,0,2" ToolTip="Anthropic API key — stored encrypted for this Windows user" />
                        <TextBlock Opacity="0.55" FontSize="12" Margin="0,0,0,14" Text="Suggestions are only proposals: nothing changes until you click Apply." />

                        <TextBlock Text="AI tools &amp; Patterns · Production" FontWeight="SemiBold" />
                        <CheckBox x:Name="McpOn" Content="Model Context Protocol endpoint at /mcp (uses the Remote PIN)" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TRIGGERS -->
            <TabItem Header="Triggers" help:ContextHelp.Topic="triggers">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                               Text="When something happens in the show, tell other gear. OSC target host:port, payload '/address arg …'. HTTP target URL, payload = body (blank = GET). Companion target host:port, payload 'page/row/column'. Command payload = a Stagewatch command. Placeholders: {ITEM} {TITLE} {PHASE} {REMAINING} {DETAIL} {ROOM}." />
                    <DataGrid x:Name="TriggerGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionUnit="FullRow" RowHeight="34"
                              help:ContextHelp.Tip="trigger-grid">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheck}" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1*" EditingElementStyle="{StaticResource GridEditBox}" />
                            <DataGridComboBoxColumn x:Name="EventColumn" Header="When" SelectedItemBinding="{Binding Event}" Width="130"
                                                    ElementStyle="{StaticResource GridCombo}" EditingElementStyle="{StaticResource GridCombo}" />
                            <DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="80" EditingElementStyle="{StaticResource GridEditBox}" />
                            <DataGridComboBoxColumn x:Name="ActionColumn" Header="Do" SelectedItemBinding="{Binding Action}" Width="130"
                                                    ElementStyle="{StaticResource GridCombo}" EditingElementStyle="{StaticResource GridCombo}" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1*" EditingElementStyle="{StaticResource GridEditBox}" />
                            <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="1.4*" EditingElementStyle="{StaticResource GridEditBox}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Filter: phase name (warning, wrapup, overtime) for Phase; item number for Item start/end; target (speaker, Lighting…) for Ack / Message. Each trigger fires at most once a second." />
                </Grid>
            </TabItem>

            <!-- ABOUT -->
            <TabItem Header="About" help:ContextHelp.Topic="licence">
                <StackPanel Margin="14">
                    <TextBlock Text="Stagewatch" FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="Pro countdown timer for corporate events" Opacity="0.6" />
                    <TextBlock x:Name="VersionLine" Margin="0,4,0,0" Opacity="0.6" />
                    <TextBlock Margin="0,12,0,0">
                        <Run Text="Developer: " />
                        <Hyperlink x:Name="LinkedInLink" Click="OnOpenLinkedIn" Foreground="#60A5FA">
                            <Run Text="LinkedIn profile" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Part of Patterns" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="520" HorizontalAlignment="Left"
                               Text="Stagewatch will become part of Patterns, the show control ecosystem being created by Ben Rohleder. Stagewatch is the timing piece of that family of tools." />
                    <TextBlock x:Name="LicenseLine" Margin="0,12,0,0" />
                    <TextBlock x:Name="HwidLine"    Margin="0,4,0,12" Opacity="0.7" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Copy hardware ID" Width="180" HorizontalAlignment="Left" Click="OnCopyHwid" />
                        <Button x:Name="DiagnosticsButton" Content="Copy diagnostics" Width="180" Margin="8,0,0,0" Click="OnCopyDiagnostics"
                                ToolTip="Copies a support report (versions, displays, outputs, connections, recent activity). Never includes your PIN or serial." />
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticsNote" Opacity="0.6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock Margin="0,18,0,0" Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                               Text="NDI output uses the free NDI Runtime (install NDI Tools from ndi.video/tools). NDI® is a registered trademark of Vizrt NDI AB." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Help (F1)" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="12,6" MinWidth="0" Click="OnHelp"
                ToolTip="Help for this tab. Right-click any option for a short explanation." />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="Save" Width="100" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
