<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Stagewatch.Remote</RootNamespace>
    <AssemblyName>Stagewatch.Remote</AssemblyName>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timer.Core\Timer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR codes for the audience question page and phone pairing (MIT). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Browser pages ship inside the dll: nothing to install, nothing to lose. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
