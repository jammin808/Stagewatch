<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lab line LB-1 (Show Bus 1.3 §2; its record is in docs/WHATS_NEXT.md): which carrier reaches every app listening on the hello
    port on one machine, with the network up and with every adapter off. A console of its own that references nothing of
    Stagewatch, so it measures the operating system's sockets and nothing else. It is not a test: tools/test.sh's build lane
    builds it, and a person runs it. The suite references it (BusCarrierProbeTests: its words, its reading of what was heard,
    and a run of its own on a free port), so the Windows job compiles it too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BusCarrierProbe</AssemblyName>
    <RootNamespace>Stagewatch.BusCarrierProbe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stagewatch.Tests" />
  </ItemGroup>

</Project>
