{
	"name": "stagewatch",
	"version": "2.16.0",
	"description": "Bitfocus Companion module for the Stagewatch stage timer",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "npm run build && node --test test/*.test.mjs",
		"check": "companion-module-check",
		"package": "npm run build && companion-module-build",
		"format": "prettier -w ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-stagewatch.git"
	},
	"engines": {
		"node": "^22.20"
	},
	"dependencies": {
		"@companion-module/base": "2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.19.17",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
